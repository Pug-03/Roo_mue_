# ─────────────────────────────────────────────────────────────────────────
# Roo_mue environment template. Copy to `.env` and fill in.
# Local development runs entirely on the values committed in `.env`.
# ─────────────────────────────────────────────────────────────────────────

# ---- Database (PostgreSQL — Neon / Supabase / any Postgres) ----------------
# Used for BOTH local dev and production. Get a free Postgres at neon.tech,
# copy its connection string here, then run `pnpm db:push` once to create the
# tables. Example:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/roomue?sslmode=require"
DATABASE_URL=""

# ---- WLASL ASL-word mode (local-only feature flag) -------------------------
# The WLASL camera mode needs the local Python server (wlasl-server/) which
# can't run on serverless hosts. Set to "true" for local dev to show the mode;
# leave unset in production to hide it.
NEXT_PUBLIC_ENABLE_WLASL="true"

# ---- NextAuth --------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="dev-only-secret-change-me"

# ---- Test access (demo login, no registration) ----------------------------
# Entering this code in BOTH email and password fields signs in to a shared
# demo account. Set ENABLE_TEST_LOGIN=false to disable (recommended in prod).
TEST_LOGIN_CODE="12345678"
ENABLE_TEST_LOGIN="true"

# ---- Google OAuth ----------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Supabase Storage (session data / translation history assets) ----------
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ---- WLASL word-level ASL mode (local inference server) --------------------
# HuggingFace no longer serves WLASL models on its free Inference API, so this
# mode runs the model locally via the FastAPI server in ./wlasl-server .
# See wlasl-server/README.md to install & run it. Override only if you changed
# the server's port/host.
# WLASL_SERVER_URL="http://localhost:8000/predict"
#
# Optional HuggingFace token — NOT required for the WLASL mode (the model is
# public and downloaded by the local server), kept here for future use.
HF_API_TOKEN=""

# ---- Email OTP (registration step 3) ---------------------------------------
# SMTP for sending the 6-digit verification code. Leave blank in dev to log
# the code to the server console instead of sending email.
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="Roo_mue <no-reply@roomue.app>"
